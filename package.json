{
  "name": "cuboid-launcher",
  "version": "4.0.0",
  "launcherVersion": 40,
  "description": "Cuboid — a desktop launcher for local Minecraft builds, Fabric/Quilt/Forge/NeoForge, Modrinth mods, resource packs and per-profile memory tuning.",
  "main": "src/main/main.js",
  "author": {
    "name": "thedistromaker",
    "email": "thedistromaker@github.com"
  },
  "homepage": "https://github.com/thedistromaker/SquareLauncher",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "icons": "python3 tools/make-icons.py",
    "check": "node --check src/main/main.js && node --check src/preload/preload.js && node --check src/renderer/app.js",
    "smoke": "node tools/check-html.js && node tools/smoke-test.js",
    "test:ui": "node tools/renderer-test.js"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^24.1.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "extract-zip": "^2.0.1",
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.thedistromaker.cuboid",
    "productName": "Cuboid",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "version.txt"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "version.txt",
        "to": "version.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "assets/icons/icon.png"
    },
    "dmg": {
      "background": null,
      "backgroundColor": "#111324",
      "icon": null,
      "writeUpdateInfo": false
    },
    "linux": {
      "target": ["deb", "rpm", "AppImage"],
      "icon": "assets/icons/icon.png",
      "category": "Game"
    }
  }
}
