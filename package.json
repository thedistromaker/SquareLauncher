{
  "name": "square-launcher",
  "version": "2.2.1",
  "description": "A desktop launcher for local game builds, with Microsoft/Minecraft account sign-in and official asset fetching.",
  "main": "src/main/main.js",
  "author": {
    "name": "thedistromaker",
    "email": "thedistromaker@github.com"
  },
  "homepage": "https://github.com/thedistromaker/SquareLauncher",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "extract-zip": "^2.0.1",
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.thedistromaker.squarelauncher",
    "productName": "Square Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.icns"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  }
}
